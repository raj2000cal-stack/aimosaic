# Leave empty to run in demo mode (canned replies, no spend).
OPENROUTER_API_KEY=

# Postgres connection string. Leave empty to run without saved chats.
# Example: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Private beta: when set, sign-up requires this invite code. Leave empty for open sign-up.
BETA_INVITE_CODE=

# Plan given to new accounts: free (default), plus or pro.
SIGNUP_PLAN=free

# Comma-separated emails of accounts allowed to open /admin.
ADMIN_EMAILS=

# --- Billing (Stripe). Leave empty to keep every account free. ---
# Public address of the app, e.g. https://aimosaic.ai
APP_URL=
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint that points at /api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Price ids created in the Stripe dashboard
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TOPUP=
